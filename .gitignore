:root {
  --bg: #0b1020;
  --bg-soft: #121a2d;
  --panel: rgba(17, 24, 39, 0.86);
  --panel-alt: rgba(15, 23, 42, 0.96);
  --primary: #f43f5e;
  --primary-strong: #fb7185;
  --text: #e5edf8;
  --muted: #9aa9bf;
  --line: rgba(148, 163, 184, 0.2);
  --shadow: 0 30px 60px rgba(15, 23, 42, 0.5);
}

* {
  box-sizing: border-box;
}

html, body, #root {
  margin: 0;
  min-height: 100%;
  height: 100%;
  font-family: 'Inter', sans-serif;
  background:
    radial-gradient(circle at top left, rgba(244, 63, 94, 0.22), transparent 34%),
    radial-gradient(circle at bottom right, rgba(37, 99, 235, 0.18), transparent 24%),
    var(--bg);
  color: var(--text);
}

button, input {
  font: inherit;
}

button {
  cursor: pointer;
}

.app-shell {
  display: flex;
  min-height: 100vh;
  padding: 22px;
  gap: 22px;
}

.sidebar {
  width: 260px;
  background: rgba(17, 24, 39, 0.7);
  border: 1px solid var(--line);
  border-radius: 24px;
  padding: 20px 16px;
  box-shadow: var(--shadow);
  backdrop-filter: blur(14px);
}

.brand-row {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 8px 10px 20px;
}

.brand-mark {
  width: 42px;
  height: 42px;
  border-radius: 14px;
  display: grid;
  place-items: center;
  font-weight: 800;
  background: linear-gradient(135deg, #ff5f6d, #ffc371);
  color: #fff;
}

.brand-name {
  margin: 0;
  font-size: 1.05rem;
  font-weight: 700;
}

.brand-tag {
  font-size: 0.72rem;
  color: var(--muted);
}

.nav {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-top: 12px;
}

.nav-item {
  background: transparent;
  border: 1px solid transparent;
  color: var(--text);
  text-align: left;
  padding: 12px 12px;
  border-radius: 12px;
  transition: 0.2s ease;
}

.nav-item.active,
.nav-item:hover {
  background: rgba(148, 163, 184, 0.08);
  border-color: var(--line);
}

.mini-card {
  margin-top: 24px;
  background: rgba(15, 23, 42, 0.7);
  border: 1px solid var(--line);
  border-radius: 18px;
  padding: 18px 14px;
}

.mini-title {
  margin: 0 0 12px;
  color: var(--muted);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  font-size: 0.7rem;
}

.mini-card ul {
  margin: 0;
  padding-left: 18px;
  display: grid;
  gap: 10px;
  color: var(--text);
}

.main-panel {
  flex: 1;
  background: rgba(15, 23, 42, 0.65);
  border: 1px solid var(--line);
  border-radius: 28px;
  padding: 18px 20px 28px;
  box-shadow: var(--shadow);
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  padding: 8px 12px 18px;
}

.search-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12px;
  max-width: 760px;
  background: rgba(15, 23, 42, 0.95);
  border: 1px solid var(--line);
  border-radius: 16px;
  padding: 0 16px;
}

.search-wrap input {
  flex: 1;
  height: 52px;
  border: none;
  outline: none;
  background: transparent;
  color: var(--muted);
  font-size: 0.97rem;
}

.search-icon {
  color: var(--muted);
  font-size: 1.3rem;
}

.topbar-actions {
  display: flex;
  align-items: center;
  gap: 12px;
}

.ghost-btn, .secondary-btn {
  border: 1px solid var(--line);
  background: rgba(148, 163, 184, 0.06);
  color: var(--text);
  padding: 10px 16px;
  border-radius: 12px;
}

.profile-pill {
  border: none;
  width: 42px;
  height: 42px;
  border-radius: 50%;
  background: linear-gradient(135deg, #5eead4, #3b82f6);
  color: #03111d;
  font-weight: 800;
}

.featured-card {
  display: grid;
  grid-template-columns: 1.2fr 0.8fr;
  gap: 18px;
  background: linear-gradient(135deg, rgba(244, 63, 94, 0.16), rgba(59, 130, 246, 0.08));
  border: 1px solid var(--line);
  border-radius: 24px;
  padding: 24px;
  min-height: 260px;
}

.eyebrow {
  display: inline-block;
  margin-bottom: 14px;
  padding: 8px 12px;
  border-radius: 999px;
  background: rgba(248, 250, 252, 0.05);
  color: #f9a8d4;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  font-size: 0.7rem;
  font-weight: 600;
}

.featured-copy h1 {
  margin: 0;
  font-size: clamp(2rem, 3vw, 3.5rem);
  line-height: 1.04;
  letter-spacing: -0.05em;
}

.featured-copy p {
  margin: 14px 0 0;
  max-width: 560px;
  color: var(--muted);
  line-height: 1.6;
}

.featured-actions {
  display: flex;
  gap: 12px;
  margin-top: 22px;
}

.primary-btn {
  border: none;
  background: linear-gradient(135deg, var(--primary), var(--primary-strong));
  color: white;
  padding: 12px 18px;
  border-radius: 12px;
  font-weight: 700;
}

.featured-visual {
  position: relative;
  border-radius: 22px;
  min-height: 200px;
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.08), rgba(13, 24, 45, 0.2)),
    url('https://images.unsplash.com/photo-1485846234645-a62644f84728?auto=format&fit=crop&w=900&q=80') center/cover no-repeat;
  overflow: hidden;
}

.orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(40px);
}

.orb-one {
  width: 160px;
  height: 160px;
  background: rgba(244, 63, 94, 0.7);
  top: 32px;
  left: 22px;
}

.orb-two {
  width: 120px;
  height: 120px;
  background: rgba(59, 130, 246, 0.85);
  bottom: 26px;
  right: 36px;
}

.video-badge {
  position: absolute;
  left: 20px;
  bottom: 18px;
  padding: 10px 12px;
  background: rgba(2, 6, 23, 0.7);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 12px;
  color: #e5edf8;
  font-size: 0.8rem;
}

.dot {
  display: inline-block;
  width: 8px;
  height: 8px;
  margin-right: 8px;
  border-radius: 50%;
  background: #22c55e;
}

.chip-row {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  margin: 20px 0 18px;
}

.chip {
  border: 1px solid var(--line);
  background: rgba(148, 163, 184, 0.05);
  color: var(--muted);
  padding: 10px 14px;
  border-radius: 999px;
}

.chip.active {
  background: rgba(244, 63, 94, 0.12);
  color: #fecdd3;
  border-color: rgba(244, 63, 94, 0.38);
}

.videos-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(220px, 1fr));
  gap: 18px;
}

.video-card {
  background: rgba(15, 23, 42, 0.7);
  border-radius: 18px;
  border: 1px solid var(--line);
  overflow: hidden;
}

.thumb {
  position: relative;
  height: 180px;
  background-size: cover;
  background-position: center;
}

.duration {
  position: absolute;
  right: 10px;
  bottom: 10px;
  background: rgba(2, 6, 23, 0.8);
  color: white;
  border-radius: 8px;
  padding: 5px 7px;
  font-size: 0.72rem;
}

.card-meta {
  display: flex;
  gap: 12px;
  padding: 12px 12px 16px;
}

.avatar {
  width: 36px;
  height: 36px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  font-weight: 700;
  color: rgba(255,255,255,0.9);
  flex-shrink: 0;
}

.details h3 {
  margin: 0;
  font-size: 1rem;
  line-height: 1.45;
}

.details p {
  margin: 4px 0 0;
  color: var(--muted);
  font-size: 0.82rem;
}

@media (max-width: 980px) {
  .app-shell {
    flex-direction: column;
  }

  .sidebar {
    width: 100%;
  }

  .videos-grid {
    grid-template-columns: repeat(2, minmax(220px, 1fr));
  }
}

@media (max-width: 680px) {
  .app-shell {
    padding: 14px;
  }

  .featured-card {
    grid-template-columns: 1fr;
  }

  .videos-grid {
    grid-template-columns: 1fr;
  }

  .topbar {
    flex-direction: column;
    align-items: stretch;
  }

  .topbar-actions {
    justify-content: space-between;
  }
}
